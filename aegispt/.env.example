# AegisPT Configuration (copy to .env and customize)

# Bind strictly to localhost by default for privacy
AEGISPT_HOST=127.0.0.1
AEGISPT_PORT=8443

# Optional fixed API token (if blank, auto-generated in data/.api_token on startup)
AEGISPT_API_TOKEN=

# Local data and artifact storage
AEGISPT_DATA_DIR=./data

# Default Local or Cloud Ollama Endpoint (e.g. http://127.0.0.1:11434 or https://ollama.com)
AEGISPT_OLLAMA_URL=http://127.0.0.1:11434
AEGISPT_OLLAMA_API_KEY=
AEGISPT_OLLAMA_FAST_MODEL=qwen2.5:3b
AEGISPT_OLLAMA_REASONING_MODEL=qwen2.5-coder:7b

# Optional Remote OpenAI-Compatible Endpoint (vLLM, llama.cpp, OpenRouter, etc.)
AEGISPT_REMOTE_LLM_URL=
AEGISPT_REMOTE_LLM_API_KEY=
AEGISPT_REMOTE_FAST_MODEL=
AEGISPT_REMOTE_REASONING_MODEL=
AEGISPT_REDACT_OUTBOUND=true

# Optional OWASP ZAP Headless Daemon
AEGISPT_ZAP_URL=http://127.0.0.1:8080
AEGISPT_ZAP_API_KEY=

# Execution Safety Limits
AEGISPT_DEFAULT_TOOL_TIMEOUT=180
AEGISPT_MAX_OUTPUT_BYTES=2097152
AEGISPT_DEFAULT_MAX_STEPS=25
