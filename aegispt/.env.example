# AegisPT Configuration (copy to .env and customize)

# === Server Binding & CLI Target ===
# Bind strictly to localhost by default for privacy.
# Never expose 0.0.0.0 on untrusted networks without TLS via a hardened reverse proxy.
AEGISPT_HOST=127.0.0.1
AEGISPT_PORT=8443
# Optional CLI override when targeting a non-default server URL (e.g. http://127.0.0.1:8443)
AEGISPT_SERVER_URL=

# === Authentication & Local Secrets ===
# Optional fixed API token (if blank, auto-generated with 0600 permissions in data/.api_token)
AEGISPT_API_TOKEN=
# Set to 1 only if you want `./aegispt serve` to print the raw bearer token on startup
# (default 0 masks startup output; retrieve the token anytime via `./aegispt token`)
AEGISPT_PRINT_TOKEN=0

# === Local Data & Artifact Storage ===
# Directory for SQLite DBs, encrypted vault key, logs, and tool artifacts (enforced 0700)
AEGISPT_DATA_DIR=./data

# === LLM Routing & Provider Mode ===
# Mode: "auto" (use configured Ollama/remote provider) or "offline" (disable outbound LLM calls)
AEGISPT_LLM_MODE=auto

# Default Local or Cloud Ollama Endpoint (e.g. http://127.0.0.1:11434 or https://ollama.com)
AEGISPT_OLLAMA_URL=http://127.0.0.1:11434
AEGISPT_OLLAMA_API_KEY=
# Note: ./scripts/setup_ollama.sh defaults to --light (qwen2.5:1.5b + qwen2.5:3b for 7.5-8 GB RAM);
# pass --coder (qwen2.5:3b + qwen2.5-coder:7b) on hosts with 12+ GB RAM.
AEGISPT_OLLAMA_FAST_MODEL=qwen2.5:3b
AEGISPT_OLLAMA_REASONING_MODEL=qwen2.5-coder:7b

# Optional Remote OpenAI-Compatible Endpoint (vLLM, llama.cpp, OpenRouter, etc.)
AEGISPT_REMOTE_LLM_URL=
AEGISPT_REMOTE_LLM_API_KEY=
AEGISPT_REMOTE_FAST_MODEL=
AEGISPT_REMOTE_REASONING_MODEL=
# Mask bearer tokens, cookies, API keys, JWTs, and private keys before non-local LLM calls
AEGISPT_REDACT_OUTBOUND=true

# === Optional OWASP ZAP Headless Daemon ===
AEGISPT_ZAP_URL=http://127.0.0.1:8080
AEGISPT_ZAP_API_KEY=

# === Execution Safety & Approval Bounds ===
AEGISPT_DEFAULT_TOOL_TIMEOUT=180
AEGISPT_MAX_OUTPUT_BYTES=2097152
AEGISPT_DEFAULT_MAX_STEPS=25
AEGISPT_APPROVAL_TIMEOUT_SECONDS=3600
